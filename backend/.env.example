GEMINI_API_KEY=your_gemini_api_key
CHROMA_PERSIST_DIR=./storage/chroma
DOCS_DIR=./data
TOP_K=4
SIMILARITY_CUTOFF=0.5
RAG_FALLBACK_MESSAGE=I don't know based on the provided knowledge base.

# --- Graphiti / Neo4j ---
# Set ENABLE_GRAPHITI=false to keep the original RAG-only flow.
ENABLE_GRAPHITI=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti_dev_password
# KB episodes (docs from /ingest) — this is what the Cytoscape canvas renders.
GRAPHITI_GROUP_ID=llama-index-poc-kb
# Chat episodes live in their own group so they don't pollute the KB graph.
GRAPHITI_CHAT_GROUP_ID=llama-index-poc-chat
# Set true to push every chat turn into Graphiti as a message episode. Off by
# default — most demos want only the KB graph visualised, no Q/A noise.
ENABLE_CHAT_EPISODES=false
# Gemini model names for Graphiti (google-genai SDK naming).
# If gemini-embedding-001 is unavailable in your region, try text-embedding-004.
GRAPHITI_LLM_MODEL=gemini-2.5-flash
GRAPHITI_EMBEDDING_MODEL=gemini-embedding-001
